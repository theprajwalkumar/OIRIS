# Backend (server) — copy to .env locally, or set in your host's dashboard.
# On local machines OpenSky credentials are normally read from the gitignored
# credentials.json; these env vars are the cloud equivalent.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
PORT=3001

# Frontend (Vite, build-time). Only needed when the static frontend is hosted
# separately from the backend (e.g. Vercel). Leave blank for same-origin/dev.
VITE_API_BASE=
# Optional explicit WebSocket URL; derived from VITE_API_BASE when omitted.
# VITE_WS_URL=
